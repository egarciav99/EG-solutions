# GEMINI_API_KEY: Required for Gemini AI API calls and lead classification.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the lead classification model (defaults to gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Admin SDK (Firestore lead storage)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Nodemailer / Gmail App Password
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Notification recipient email
NOTIFY_EMAIL=""
